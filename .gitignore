# === 通用忽略 ===
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
*.swo

# === Node.js / React (webentry) ===
node_modules/
dist/
build/
*.tsbuildinfo
.env
.env.local
.env.*.local

# === Unity (gamedev/Unity_dev) ===
# Unity 生成的临时和构建文件
gamedev/Unity_dev/[Ll]ibrary/
gamedev/Unity_dev/[Tt]emp/
gamedev/Unity_dev/[Oo]bj/
gamedev/Unity_dev/[Bb]uild/
gamedev/Unity_dev/[Bb]uilds/
gamedev/Unity_dev/[Ll]ogs/
gamedev/Unity_dev/[Uu]ser[Ss]ettings/
gamedev/Unity_dev/[Mm]emoryCaptures/
gamedev/Unity_dev/[Rr]ecordings/

# Unity 自动生成的 VS/IDE 文件
gamedev/Unity_dev/*.csproj
gamedev/Unity_dev/*.unityproj
gamedev/Unity_dev/*.sln
gamedev/Unity_dev/*.suo
gamedev/Unity_dev/*.tmp
gamedev/Unity_dev/*.user
gamedev/Unity_dev/*.userprefs

# === PixiJS / Phaser / 其他 JS 引擎 (gamedev/xx_dev) ===
gamedev/*_dev/node_modules/
gamedev/*_dev/dist/
gamedev/*_dev/build/
gamedev/*_dev/.cache/

# === IDE 配置 ===
.vscode/
.idea/
*.iml